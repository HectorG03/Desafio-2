  <Source dwd:design-time-name="361a52be-dca8-4bc5-9fc2-9637befd8e2b">
    <DataSourceViewID>Adventure Works DW</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="d919a488-a7d0-4b8e-b03c-356bf6f990a3">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T06:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T06:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
Script de cálculos del cubo Cubo_Ventas.
*/
CALCULATE; 

CREATE MEMBER CURRENTCUBE.[Measures].[Utilidad]
 AS [Measures].[Sales Amount] - [Measures].[Total Product Cost],
 FORMAT_STRING = "$#,##0.00",
 VISIBLE = 1; 

CREATE MEMBER CURRENTCUBE.[Measures].[Margen %]
 AS IIF([Measures].[Sales Amount] = 0, NULL,
        ([Measures].[Sales Amount] - [Measures].[Total Product Cost]) / [Measures].[Sales Amount]),
 FORMAT_STRING = "0.00%",
 VISIBLE = 1; 

CREATE MEMBER CURRENTCUBE.[Measures].[Ticket Promedio]
 AS IIF([Measures].[Pedidos] = 0, NULL,
        [Measures].[Sales Amount] / [Measures].[Pedidos]),
 FORMAT_STRING = "$#,##0.00",
 VISIBLE = 1; 

CREATE MEMBER CURRENTCUBE.[Measures].[Descuento %]
 AS IIF([Measures].[Sales Amount] = 0, NULL,
        [Measures].[Discount Amount] / [Measures].[Sales Amount]), 
FORMAT_STRING = "0.00%", 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>